{
  "expo": {
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita que o Guardia use sua localização para enviar alertas SOS.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-build-properties"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.guilhermechedid.guardiaapp"
    },
    "extra": {
      "eas": {
        "projectId": "855360c5-99a6-436c-a7e2-97e814995f75"
      }
    }
  }
}
