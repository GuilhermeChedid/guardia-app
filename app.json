{
  "expo": {
    "name": "Guardiã",
    "slug": "guardia-app",
    "icon": "./src/assets/imagens/icon_guardia.png",
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-dynamic-app-icon",
        {
          "guardia": {
            "image": "./src/assets/imagens/icon_guardia.png",
            "prerendered": true
          },
          "calculator": {
            "image": "./src/assets/imagens/icon_calculator.png",
            "prerendered": true
          },
          "guide": {
            "image": "./src/assets/imagens/icon_guide.png",
            "prerendered": true
          },
          "files": {
            "image": "./src/assets/imagens/icon_files.png",
            "prerendered": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita que o Guardia use sua localização para enviar alertas SOS.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withDynamicAppIconJvmTarget"
    ],
    "android": {
      "icon": "./src/assets/imagens/icon_guardia.png",
      "permissions": [
        "CALL_PHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/imagens/icon_guardia.png",
        "backgroundColor": "#3B1D4B"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.guilhermechedid.guardiaapp"
    },
    "extra": {
      "eas": {
        "projectId": "4d7a5f43-b8f1-4e32-8886-c31c623b22f9"
      }
    },
    "owner": "guilhermechedids-team"
  }
}
